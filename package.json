{
    "name": "science-feed",
    "version": "1.1.0",
    "private": true,
    "type": "module",
    "browserslist": [
        ">0.3%, defaults, supports es6-module"
    ],
    "scripts": {
        "lint": "oxlint",
        "test": "bun test",
        "knip": "knip-bun",
        "dk": "drizzle-kit",
        "ui": "bunx shadcn@latest",
        "cli": "bun --bun src/cli/cli.ts",
        "dev": "bun --bun vite dev --port 3000",
        "seed": "bun --bun src/cli/cli.ts seed-rss-feeds",
        "build": "bun --bun vite build && bun run build:cli",
        "migrate:auth": "bun --bun scripts/migrate-script.ts",
        "build:cli": "bun build src/cli/cli.ts --target bun --outfile dist/cli.js",
        "auth:generate": "npx @better-auth/cli@latest generate -y --output src/lib/server/database/schema/auth.schema.ts --config src/lib/server/auth/"
    },
    "dependencies": {
        "@t3-oss/env-core": "^0.13.11",
        "@tanstack/react-query": "^5.101.3",
        "@tanstack/react-router": "^1.170.18",
        "@tanstack/react-router-ssr-query": "^1.167.1",
        "@tanstack/react-start": "^1.168.32",
        "better-auth": "1.6.23",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "commander": "^15.0.0",
        "drizzle-orm": "^0.45.2",
        "fast-xml-parser": "^5.10.1",
        "lucide-react": "^1.25.0",
        "nprogress": "^0.2.0",
        "p-limit": "^7.3.1",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-hook-form": "^7.82.0",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3",
        "@base-ui/react": "^1.6.0",
        "tw-animate-css": "^1.4.0",
        "shadcn": "^4.22.1"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@libsql/client": "^0.17.4",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query-devtools": "^5.101.3",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^26.1.1",
        "@types/nprogress": "^0.2.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "bun-types": "^1.3.14",
        "drizzle-kit": "^0.31.10",
        "knip": "^6.27.0",
        "oxlint": "^1.74.0",
        "oxlint-tsgolint": "^0.25.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "vite-plugin-react-click-to-component": "^4.2.2"
    }
}
