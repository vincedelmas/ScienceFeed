{
    "name": "science-feed",
    "version": "1.2.0",
    "private": true,
    "type": "module",
    "browserslist": [
        ">0.3%, defaults, supports es6-module"
    ],
    "scripts": {
        "lint": "oxlint",
        "test": "bun test",
        "knip": "knip-bun",
        "dk": "drizzle-kit",
        "ui": "bunx shadcn@latest",
        "cli": "bun --bun src/cli/cli.ts",
        "dev": "bun --bun vite dev --port 3000",
        "seed": "bun --bun src/cli/cli.ts seed-rss-feeds",
        "build": "bun --bun vite build && bun run build:cli",
        "migrate:auth": "bun --bun scripts/migrate-script.ts",
        "build:cli": "bun build src/cli/cli.ts --target bun --outfile dist/cli.js",
        "auth:generate": "bunx --bun auth@1.7.17 generate -y --output src/lib/server/database/schema/auth.schema.ts --config src/lib/server/auth/auth.ts"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@libsql/client": "^0.18.0",
        "@t3-oss/env-core": "^0.13.11",
        "@tanstack/react-query": "^5.106.1",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-router-ssr-query": "^1.167.3",
        "@tanstack/react-start": "^1.169.4",
        "better-auth": "1.7.17",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.5.2",
        "commander": "^15.0.0",
        "drizzle-kit": "^0.31.11",
        "drizzle-orm": "^0.45.4",
        "fast-xml-parser": "^5.12.0",
        "lucide-react": "^1.69.0",
        "nprogress": "^0.2.0",
        "p-limit": "^7.3.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-hook-form": "^7.91.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^8.1.0",
        "@rolldown/plugin-babel": "^0.3.0",
        "@tailwindcss/vite": "^4.3.4",
        "@tanstack/react-query-devtools": "^5.106.1",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^26.6.6",
        "@types/nprogress": "^0.2.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "bun-types": "^1.4.4",
        "knip": "^6.44.1",
        "oxlint": "^1.91.0",
        "oxlint-tsgolint": "^7.0.2006",
        "tailwindcss": "^4.3.4",
        "typescript": "^7.0.2",
        "vite": "^8.3.6",
        "vite-plugin-react-click-to-component": "^4.2.3",
        "shadcn": "^4.23.0"
    }
}
